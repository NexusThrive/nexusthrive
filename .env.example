DATABASE_URL=postgres://nexusthrive:nexusthrive@localhost:55432/nexusthrive?sslmode=disable
# Password of the nexusthrive_api role, applied by `task db:migrate`; empty keeps it NOLOGIN.
API_DB_PASSWORD=
# Connection of the API as the limited role; the API must never use DATABASE_URL.
API_DATABASE_URL=
REDIS_URL=redis://localhost:6379
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
# Comma-separated exact authorized origins; required outside development.
CLERK_AZP=
# Optional expected token audience.
CLERK_AUDIENCE=
WOMPI_PUBLIC_KEY=
WOMPI_EVENTS_SECRET=
N8N_WEBHOOK_SECRET=

# Webhooks remain disabled until explicitly enabled with persistent encryption keys.
NEXUSTHRIVE_WEBHOOKS_ENABLED=0
WEBHOOK_ENCRYPTION_ACTIVE_KEY=
# JSON object of key identifiers to standard-base64 encoded 32-byte application keys.
WEBHOOK_ENCRYPTION_KEYS=
