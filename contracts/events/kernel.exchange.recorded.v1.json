{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusthrive.com.co/contracts/events/kernel.exchange.recorded.v1.json",
  "title": "Kernel exchange recorded v1",
  "description": "Payload of kernel.exchange.recorded, version 1. The envelope supplies the verified actor and request.",
  "type": "object",
  "additionalProperties": false,
  "required": ["exchange_id", "commitment_id"],
  "properties": {
    "exchange_id": { "$ref": "#/$defs/uuidV7" },
    "commitment_id": { "$ref": "#/$defs/uuidV7" }
  },
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
